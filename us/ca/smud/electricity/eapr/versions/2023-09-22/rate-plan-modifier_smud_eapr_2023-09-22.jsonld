  "@type": "urpx:URPXPackage",
  "@id": "smud:doc-eapr-2023-09-22",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "smud:eapr",
    "urpx:name": "Schedule EAPR Energy Assistance Program Rate",
    "urpx:modifierUniqueIdentifier": "EAPR",
    "urpx:initialEffectiveDate": "2023-09-22",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "smud:eapr-2023-09-22",
      "urpx:version": "2023-09-22",
      "urpx:modifierVersionNumber": "2023-09-22",
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:description": "SMUD's Energy Assistance Program Rate (EAPR) — income-qualified bill discount applied as an overlay to any SMUD residential base RatePlan. Functionally analogous to the CPUC's CARE program at SCE/PG&E/SDG&E, though structurally different: SMUD's EAPR has TWO discount components — (1) a flat $10/month System Infrastructure Fixed Charge discount, and (2) a 100%-reduction-up-to-cap on electricity usage cost where the monthly cap varies by Federal Poverty Level (FPL) tier ($60 for 0-50% FPL, $32 for >50-100%, $10 for >100-150%, $0 for >150-200%). Adopted under SMUD Board Resolution 23-09-09 effective September 22, 2023. Eligibility (Sec II): residential customer income at-or-below 200% FPL, customer not claimed as dependent, primary residence. This filing models the $10/month BSC discount as a -10.00 per month credit, and the capped usage discount as min(usage cost, cap) per FPL band, selected by a ProfileAlternatives over federalPovertyLevelBand, using urpx:ValueExpression, urpx:minOperator and urpx:currencyUnit from a draft urpx-org/urpx PR rather than from a URPX release. The ERSF Additional Monthly Discount ($0-$35/month for 0-50% FPL only, year-by-year formulaic) is also NOT modeled. Stacks additively with MED (Schedule MED Sec III). Sec IV-VI cover Nonprofit Organization eligibility — out of scope for this residential-focused filing.",
      "urpx:effectiveDateTime": "2023-09-22T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "smud:fixed"
        },
        {
          "@id": "smud:tod-5-8pm"
        },
        {
          "@id": "smud:tod-low-use"
        }
      ],
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "SMUD_SCHEDULE_EAPR.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.smud.org/-/media/Documents/Rate-Information/Rates/01_EAPR.ashx",
        "urpx:dateRetrieved": "2026-05-04",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2,
        "urpx:leafStart": "EAPR-1",
