      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "smud:eapr-2023-09-22-er-eligible",
          "urpx:name": "EAPR-eligible residential customer",
          "urpx:description": "Customer is a residential customer enrolled in the EAPR program per Schedule EAPR Sec II: (A) total gross household income conforms to Income Guidelines (typically 0-200% Federal Poverty Level — application-based determination); (B) customer is not claimed as a dependent on another person's tax return; (C) service address on application is the customer's primary residence. Stacks additively with MED.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "smud:eapr-2023-09-22-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "smud:eapr-2023-09-22-bn-residential-and-enrolled",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "smud:eapr-2023-09-22-cn-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "smud:eapr-2023-09-22-cn-residential-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "smud:eapr-2023-09-22-cn-residential-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:residentialKind"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "smud:eapr-2023-09-22-cn-program-enrollment",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "smud:eapr-2023-09-22-cn-program-enrollment-left-operand",
                    "urpx:customConditionProperty": "Program Enrollment"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "smud:eapr-2023-09-22-cn-program-enrollment-right-operand",
                    "urpx:stringValue": "Energy Assistance Program (EAPR)"
                  }
                }
              ]
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "smud:eapr-2023-09-22-plan-elements",
        "urpx:hasMetricInput": [
          {
            "@type": "urpx:MetricInput",
            "@id": "smud:eapr-mi-meter-count",
            "urpx:name": "Per Meter (for daily $/meter credits)",
            "urpx:metricInputType": {
              "@id": "urpx:profileMetricInput"
            },
            "urpx:profileMetricProperty": {
              "@id": "urpx:meterCount"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "smud:eapr-2023-09-22-mi-usage-cost",
            "urpx:name": "Electricity usage cost for the billing period",
            "urpx:description": "The customer's electricity usage cost for the billing period under the base rate plan: the sum of its Electricity Usage Charges, kWh times the per-kWh usage price in effect. The amount Schedule EAPR Section III.2 reduces by 100 percent up to the monthly maximum.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "smud:eapr-2023-09-22-mi-usage-cost-metric-specification",
              "urpx:commodity": {
                "@id": "urpx:electricity"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:currencyUnit"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "smud:eapr-2023-09-22-mi-usage-cost-calculation-method",
              "urpx:aggregationMethod": {
                "@id": "urpx:sum"
              },
              "urpx:intervalDuration": "P1M",
              "urpx:calculationFormula": "sum over the billing period of (kWh x base-plan Electricity Usage Charge per kWh)"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "smud:eapr-2023-09-22-mi-usage-discount-fpl-0-50",
            "urpx:name": "EAPR electricity usage discount, 0 to 50 percent of the federal poverty level",
            "urpx:description": "Schedule EAPR Section III.2 at 0 to 50 percent of the federal poverty level: a 100 percent reduction in electricity usage cost up to a maximum of $60 per month, so the lesser of the billing period's usage cost and 60. Not prorated (Section VIII).",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "smud:eapr-2023-09-22-mi-usage-discount-fpl-0-50-metric-specification",
              "urpx:commodity": {
                "@id": "urpx:electricity"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:currencyUnit"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "smud:eapr-2023-09-22-mi-usage-discount-fpl-0-50-calculation-method",
              "urpx:intervalDuration": "P1M",
              "urpx:calculatedBasedOn": {
                "@id": "smud:eapr-2023-09-22-mi-usage-cost"
              },
              "urpx:calculationFormula": "min(usage cost, 60)",
              "urpx:hasValueExpression": {
                "@type": "urpx:ValueExpression",
                "@id": "smud:eapr-2023-09-22-mi-usage-discount-fpl-0-50-calculation-method-value-expression",
                "urpx:rootNode": {
                  "@type": "urpx:OperationNode",
                  "@id": "smud:eapr-2023-09-22-mi-usage-discount-fpl-0-50-calculation-method-value-expression-root-node",
                  "urpx:operator": {
                    "@id": "urpx:minOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "smud:eapr-2023-09-22-mi-usage-discount-fpl-0-50-calculation-method-value-expression-root-node-left-operand",
                    "urpx:referencesMetricInput": {
                      "@id": "smud:eapr-2023-09-22-mi-usage-cost"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:DatatypeOperandNode",
                    "@id": "smud:eapr-2023-09-22-mi-usage-discount-fpl-0-50-calculation-method-value-expression-root-node-right-operand",
                    "urpx:decimalValue": "60"
                  }
                }
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "smud:eapr-2023-09-22-mi-usage-discount-fpl-50-100",
            "urpx:name": "EAPR electricity usage discount, above 50 to 100 percent of the federal poverty level",
            "urpx:description": "Schedule EAPR Section III.2 at above 50 to 100 percent of the federal poverty level: a 100 percent reduction in electricity usage cost up to a maximum of $32 per month, so the lesser of the billing period's usage cost and 32. Not prorated (Section VIII).",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
