      "urpx:hasCoverageClaim": {
        "@id": "smud:cc-eapr-2023-09-22",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "smud:cc-eapr-2023-09-22-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "Schedule EAPR grants residential customers two discounts and this filing models both. Section III.1, a $10 per month System Infrastructure Fixed Charge discount, is represented. Section III.2, a 100 percent reduction in electricity usage cost per kWh up to a monthly maximum that steps with the household's federal poverty level, $60 at 0 to 50 percent, $32 above 50 to 100 percent, $10 above 100 to 150 percent and $0 above 150 to 200 percent, is represented as the lesser of the billing period's usage cost and the cap for the selected federal poverty level band, using value-expression and currency-unit terms that no URPX release yet defines. Section III.3 is not: the EAPR Rate Stabilization Fund discount, a further $0 to $35 per month available only at 0 to 50 percent of the federal poverty level, its amount set each year by SMUD's Accountant from whatever discretionary non-retail revenue is available and fixed before the year it applies. At 0 to 50 percent of the federal poverty level it is worth up to $35 a month more than what this filing carries. Section VIII's proration of the fixed-charge discount is unrepresented: it is prorated against 30 days for billing periods shorter than 27 days. The maximum usage discount is not prorated, which the fixed monthly cap carries. Sections IV and V are out of scope rather than missing. They cover nonprofit organizations and Commercial and Industrial customers: the nonprofit eligibility tests, including the requirement that at least 75 percent of an associated daytime-services facility's square footage serve the qualifying functions, and the Commercial and Industrial discounts of 15 percent on usage, maximum demand, site infrastructure and summer peak demand charges with a 35 percent System Infrastructure Fixed Charge discount on CI-TOD1 and 15 percent on CI-TOD2 through CI-TOD4. This filing is scoped to residential service.",
          "urpx:evaluatedOn": "2026-09-21T00:00:00"
        }
      }
    }
  }
